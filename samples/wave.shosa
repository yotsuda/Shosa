// Wave — the back-and-forth is a group in braces, and `q` does it again. The whole is a
// `move`: without a length it lasts as long as it was defined (3 beats); `wave:2` squeezes it into 2.
title "Wave"
tempo 96
time 4/4

role solo
dancer solo humanoid on solo

move wave { rightArm { { up.bent:1/2 side.up.bent:1/2 } q q } }

section Wave {
  solo {
    rightArm { then side.up.bent:1/2 wave:2 then:1/2 | down:4 }   // the hand is up on 2 (it goes there through the then), down on the next 1
    head     { then fwd.right:2 then | fwd:4 }
  }
}

// The same with the left arm: `leftArm { then side.high:1/2@bent wave@mirror:2 then:1/2 | down:4 }`.

form { Wave }
score { dancer solo }
