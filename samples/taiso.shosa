// Morning exercise — the `form` says in which order the sections are played;
// where the body is and how it is posed carry over from one to the next.
title "Morning exercise"
tempo 80
time 4/4

figure solo
dancer solo humanoid on solo

section Stretch {
  solo {
    arms  { fwd up side down | fwd up side down }
    steps { both.high:2 both.mid:2 | both.low:2 both.mid:2 }
  }
}

section Bend {
  solo {
    arms  { hip hold:3 | hold:3 down }
    torso { hold left.high up right.high | up fwd.high up hold }
  }
}

form { Stretch Bend }

score { dancer solo }
