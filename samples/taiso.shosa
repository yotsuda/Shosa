// Morning exercise — the `form` says in which order the sections are played;
// where the body is and how it is posed carry over from one to the next.
title "Morning exercise"
tempo 80
time 4/4

role solo
dancer solo humanoid on solo

section Stretch {
  solo {
    arms  { fwd up side down | fwd up side down }
    steps { then then:2 then | then then:2 then }
    height { mid high:2 mid | mid low:2 mid }   // up on the toes on 2, knees bent on the next 2
  }
}

section Bend {
  solo {
    arms  { hip then:3 | then:2 then down }
    torso { then left.up up right.up | up fwd.up up then }
  }
}

form { Stretch Bend }

score { dancer solo }
