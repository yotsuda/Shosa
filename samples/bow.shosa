// Bow — a number in the place of the level is degrees above the horizontal:
// `fwd.60` leans the spine 30 degrees forward of upright (`fwd.high` is fwd.45).
title "Bow"
tempo 60
time 4/4

figure solo
dancer solo humanoid on solo

section Bow {
  solo {
    torso { hold fwd.60 hold up }
    head  { hold fwd.-20 hold fwd }
  }
}

form { Bow }
score { dancer solo }
