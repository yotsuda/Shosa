// Turning — danced to a song that changes on the way (turning.lys). The March is four bars of
// 4/4 at 120 and slows to 90 in its last bar; the Waltz is four bars of 3/4. Nothing here says
// so: the bars of each section are the song's, and a beat is as long as the song makes it.
// `shosa check samples\turning.shosa` prints where the tempo and the time change.
title "Turning"
music "turning.lys"

role solo
dancer solo humanoid on solo

section March {
  solo {
    steps { leftFoot.fwd rightFoot.fwd leftFoot.fwd rightFoot.fwd | leftFoot.back rightFoot.back leftFoot.back rightFoot.back | %2 | }
    arms  { side:2 down:2 | % | side.up:2 down:2 | side:2 up:2!top | }
  }
}

section Waltz {
  solo {
    steps { leftFoot.side:1 stand:1 then:1 | rightFoot.side:1 stand:1 then:1 | %2 | }
    height { mid:1 then:1 low:1 | % | %2 | }
    arms  { side.up:3 | fwd:3 | side.up:3 | down:3!end | }
  }
}

score { dancer solo }
