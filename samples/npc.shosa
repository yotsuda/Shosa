// NPC — small gestures, a score each (npc-Nod.glb …). Lengths in seconds where no beat matters.
title "NPC gestures"
tempo 60

role npc
dancer npc humanoid on npc

section Nod {
  npc {
    head { fwd:0.25s fwd.down(25):0.25s fwd:0.2s fwd.down(15):0.3s fwd:0.2s }   // down at 0.25 s, up, a smaller one at 0.7 s
  }
}

// A word stays for its length and the next one is gone to through all of that time. To stay
// and then go, a `then` after it: the part stays through the word, and goes through the then.
section Point {
  npc {
    rightArm { down:0.3s fwd.up.bent:0.2s fwd:1s@sharp!point then:0.6s down:0.1s }
    head     { fwd:0.3s fwd.right:1.2s then:0.6s fwd:0.1s }
  }
}

section Applaud {
  npc {
    arms { clap:1/4!clap fwd.down(20).bent:1/4 }
  }
}

section PickUp {
  npc {
    steps    { then:0.8s          then:0.4s          then:0.8s then:0.2s }
    height { mid:0.4s then:0.4s  low(40cm):0.4s then:0.8s mid:0.2s }   // goes down with the torso, from 0.4 s to 0.8 s; up again with it, by 2 s
    torso    { up:0.4s then:0.4s      fwd.up:0.4s                then:0.8s up:0.2s }
    rightArm { down:0.4s then:0.4s    fwd.down:0.2s down:0.4s!grab  then:0.6s chest:0.2s }
    head     { fwd:0.4s then:0.4s     down:0.4s                     then:0.8s fwd:0.2s }
  }
}

section LookAround {
  npc {
    head  { fwd.left:2 then:1 fwd:1 fwd.right:2 then:1 fwd:1 }
    steps { shift.left:4 shift.right:4 }      // the weight moves; neither foot leaves the floor
  }
}

section Wait {
  npc {
    arms  { shoulder.across:4 }               // arms folded: each hand to the opposite shoulder.
    steps { shift.right:4 }                   // a loop follows itself, so it is already there
  }
}

form Nod { Nod }
form Point { Point }
form Applaud { Applaud }
form PickUp { PickUp }
form LookAround { LookAround }
form Wait { Wait }

score Nod { dancer npc  form Nod }
score Point { dancer npc  form Point }
score Applaud { dancer npc  form Applaud  loop }
score PickUp { dancer npc  form PickUp }
score LookAround { dancer npc  form LookAround  loop }
score Wait { dancer npc  form Wait  loop }
