// Kick — the kick is a whole-body move (a leg and both arms), written in `body`.
// `@mirror` swaps left and right, so the second bar kicks with the other leg.
title "Kick"
tempo 100
time 4/4

role solo
dancer solo humanoid on solo

move kick {
  rightLeg { then fwd.down@sharp!hit down then }
  arms     { then side down then }
}

section Kick {
  solo {
    steps { leftFoot.fwd then:3 | rightFoot.fwd then:3 }
    body  { kick | kick@mirror }
  }
}

form { Kick }
score { dancer solo }
