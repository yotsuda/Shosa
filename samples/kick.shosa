// Kick — the kick is a whole-body move (a leg and both arms), written in `body`.
// `@mirror` swaps left and right, so the second bar kicks with the other leg.
title "Kick"
tempo 100
time 4/4

move kick {
  rightLeg { hold fwd.low@sharp!hit down hold }
  arms     { hold side down hold }
}

section Kick {
  steps { left.fwd hold:3 | right.fwd hold:3 }
  body  { kick | kick@mirror }
}
