// Hello, Shosa: two dancers introduce themselves, to a Lily# song.
// A word stands on the beat the body is THERE; the way to it is the compiler's.
// The characters are not in the repository: models/README.md says where they come from.
music "hello.lys"

role zunda
role metan
dancer zundamon humanoid "models/zundamon.vrm" height 150cm sings zunda on zunda at -0.8 0
dancer zunko    humanoid "models/zunko.vrm"    height 150cm sings metan on metan at  0.8 0

// ---- one bar each, written for zunda; metan dances them @mirror ----

// Step out and close, both ways: the hands meet as the feet do.
move touchClap {
  steps  { rightFoot.side(0.45m) together leftFoot.side(0.45m) together }
  arms   { side.down(40) clap@sharp side.down(40) clap@sharp }
  height { { low(6cm):1/2 mid:1/2 } q q q }
}

// "hajimaru YO": the hand points up and out on "yo".
move point {
  steps    { rightFoot.side(0.45m) together then:2 }
  rightArm { side.down(40):2 then:1/2 fwd.side.up(30):1 then:1/2 }
  leftArm  { side.down(40):5/2 hip:3/2@sharp }
  head     { fwd:5/2 fwd.right(25):3/2@sharp }
}

// "Zundamon to Me-": a hand on my chest, then out to my partner.
move meAndYou {
  steps    { leftFoot.side(0.45m) together then:2 }
  rightArm { chest:5/2 then:1/2 hip:1 }
  leftArm  { hip:5/2 then:1/2 side.up(10):1 }
  head     { fwd:3 fwd.left(35):1@sharp }
}

// The same words from the other side: my partner first, then me.
move youAndMe {
  steps    { rightFoot.side(0.45m) together then:2 }
  rightArm { side.up(10):5/2 then:1/2 chest:1 }
  leftArm  { hip:4 }
  head     { fwd.right(35):3 fwd:1@sharp }
}

// "futari de": a jump, the arms in a V.
move together2 {
  steps { then:2 jump.up(10cm):2 }
  arms  { then:3/2 then:1/2 side.up(50):2 }
  head  { then:2 fwd:2 }
}

// "kiite ne": a hand at the ear, leaning into it.
move listen {
  steps    { rightFoot.side(0.45m) together then:2 }
  rightArm { side.down(40):1/2 then:1/2 side.up(60).bent(130):2 then:1 }
  leftArm  { side.down(40) hip:3 }
  torso    { up up.right(10):2 then:1 }
  head     { fwd fwd.tilt(right(15)):2 then:1 }
}

// "yoroshiku ne": a bow, stepping back to where the bar before left from.
move bow {
  steps { leftFoot.side(0.45m) together:3 }
  arms  { side.down(40) then fwd.across(25).down(75) then }
  torso { up then up.fwd(35) then }
  head  { fwd then fwd.body then }
}

// "na no da!": zunda jumps, the arms up, the head to one side.
move nanoda {
  steps { then jump.up(10cm):3 }
  arms  { then:1/2 then:1/2 side.up(45):3 }
  torso { up:4 }
  head  { fwd fwd.tilt(left(15)):3@sharp }
}

// "desu wa": metan laughs behind her hand, the other on her hip.
move desuwa {
  rightArm { then:1/2 then:1/2 chin.elbow(side):3 }
  leftArm  { then hip:3 }
  torso    { up up.back(8):3 }
  head     { fwd fwd.up(15).tilt(left(10)):3 }
}

// The last picture: the outer arm up, leaning toward the partner.
pose finale {
  rightArm { side.up(50) }
  leftArm  { hip }
  torso    { up.left(8) }
  head     { fwd.left(10).tilt(left(15)) }
}

// ---- the song's sections ----

section Intro {
  zunda {
    body { then:4 | then:4 | touchClap:4 | touchClap:4 | }
    head { fwd.down(30):3 then:1 | metan.head:2 fwd:2 | skip:2bar | }
  }
  metan {
    body { then:4 | then:4 | touchClap:4@mirror | touchClap:4@mirror | }
    head { fwd.down(30):3 then:1 | zunda.head:2 fwd:2 | skip:2bar | }
  }
}

section Chorus {
  zunda {
    body { touchClap:4 | point:4 | meAndYou:4 | together2:4 |
           touchClap:4 | listen:4 | bow:4 | nanoda:4 | }
  }
  metan {
    body { touchClap:4@mirror | point:4@mirror | youAndMe:4 |
           together2:4@mirror | touchClap:4@mirror | listen:4@mirror |
           bow:4@mirror | desuwa:4 | }
  }
}

section Coda {
  zunda {
    body  { touchClap:4 | touchClap:4 | then:4 | finale:4 | }
    steps { skip:2bar | then:1 then:2 turn.right(360):1 | }
  }
  metan {
    body  { touchClap:4@mirror | touchClap:4@mirror | then:4 | finale:4@mirror | }
    steps { skip:2bar | then:1 then:2 turn.left(360):1 | }
  }
}

// The order of the sections is the song's (hello.lys: Intro, Chorus, Coda).
score { dancer zundamon  dancer zunko }
