// Box step — "forward, side, together; back, side, together". It ends where it began,
// so the section is a `loop`: the end joins the start and an engine can repeat it.
title "Box step"
tempo 90
time 3/4

section Box loop {
  steps { left.fwd right.side together | right.back left.side together }
  arms  { side.low:6 }
}
