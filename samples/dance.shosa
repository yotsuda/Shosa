// Dance — choreography for a song. Tempo, time and the order of the sections come from
// song.lys (108, 4/4, Verse then Chorus, 4 bars each); a section here is danced during the
// song's section of the same name. Three dancers share two figures: carol dances `chorus` mirrored.
// `shosa midi samples\dance.shosa` writes the song as it is danced.
title "Dance"
music "song.lys"

role lead
role chorus
dancer alice humanoid on lead    at 0 1
dancer bob   humanoid on chorus  at -1.5 0
dancer carol humanoid on chorus  at 1.5 0  mirror

move grapevine { steps { leftFoot.side rightFoot.back.across leftFoot.side stand } }

section Verse {
  lead {
    steps { grapevine | grapevine@mirror | grapevine | grapevine@mirror }
    arms  { side:4 | up:4 | side:4 | down:4 }
  }
  chorus {
    steps { leftFoot.side stand rightFoot.side stand | % | % | % | }
  }
}

section Chorus {
  lead {
    steps { leftFoot.fwd@turn(left(90)) rightFoot.fwd leftFoot.back stand | % | % | % | }
    arms  { side.up up side.up down | % | % | % | }
  }
  chorus {
    arms { clap!clap side.up up then | % | % | % | }    // the hands meet on 1; they come down for it through 4 (`then`)
  }
}

score { dancer alice  dancer bob  dancer carol }
