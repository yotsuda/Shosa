// A slow, lyrical phrase that never hurries, down to the floor and up again: kneeling, a bow over the knees with the
// hands on the floor, one knee, sitting with a leg lifted, a fold over the legs, lying back, the hips and the legs
// to the sky, a straddle in the air, and back up through the seat and the knees. One section, so every way is seen.
title "On the floor"
tempo 84

role solo
dancer solo humanoid "../models/zunko.vrm" on solo

section Floor {
  solo {
    steps    { stand:4 | then:4 | knees:4 | then:4 | rightKnee:4 | then:4 | seat.back(0.3m):4 | then:4 | then:4 |
               back.back(0.4m):4 | then:4 | then:4 | seat.fwd(0.4m):4 | then:4 | knees.fwd(0.3m):4 | then:4 | feet:4 | then:4 | }
    height   { mid:4 | then:4 | mid:2 then:2 | low(30cm):2 then:2 | mid:4 | then:13bar | }
    torso    { up:4 | then:4 | up:2 then:2 | up.fwd(40):2 then:2 | up:4 | up.back(10):2 then:2 | up:2 then:2 | back.up(35):2 then:2 | up.fwd(25):2 then:2 |
               back:2 then:2 | back.down(25):2 then:2 | back:4 | up:4 | then:4 | up:4 | up.back(10):2 then:2 | up:4 | then:4 | }
    legs     { down:4 | then:4 | then:4 | then:4 | then:4 | then:4 | fwd.floor.bent(90):4 | then:4 | down:2 then:2 |
               down:2 then:2 | fwd.up(75):2 then:2 | side.up(40):2 then:2 | fwd.floor.bent(90):4 | then:2 down:2 | down:4 | then:4 | then:4 | then:4 | }
    rightLeg { skip:7bar | then:2 fwd.up(40):2 | skip:10bar | }
    arms     { down:2 then:2 | side.up(30):2 then:2 | side:2 then:2 | fwd.floor:2 then:2 | side.up(45):2 then:2 | fwd.up(20):2 then:2 |
               back.floor:4 | then:4 | fwd.down(20):2 then:2 | side.floor:4 | then:4 | then:4 | back.floor:2 then:2 | side.down(20):2 fwd:2 |
               side.up(50):2 then:2 | fwd.up(60):2 then:2 | side:2 then:2 | down:4 | }
    hands    { soft:4 | then:8bar | open.palm(up):4 | then:2bar | soft:4 | then:5bar | }
    head     { fwd:4 | fwd.up(15):2 then:2 | fwd:2 then:2 | fwd.down(30):2 then:2 | fwd.up(15):2 then:2 | fwd.up(25):2 then:2 | fwd:4 | then:11bar | }
  }
}

form { Floor }
score { dancer solo }
