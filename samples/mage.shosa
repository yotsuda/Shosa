// Mage — `free` on the dancer: the rules of weight and gravity do not apply to this body,
// so it can hang in the air.
title "Mage"
tempo 90


figure mage
dancer mage humanoid on mage free

pose hover {
  steps    { lift(0.3) }                    // the feet 0.3 m above the floor
  leftLeg  { fwd.-70@bent }
  arms     { side.low }
}

section Float {
  mage {
    body  { hover:4 }
    arms  { side.-30:2 side.low:2 }
  }
}

section Cast {
  mage {
    // The arms rise through the first three beats, the body leans back with them; on 5 (beat 4)
    // everything is thrown forward at once — `@sharp` goes just before its beat, not all the way there.
    body  { hover:6 }
    arms  { skip:2 side.high up fwd@sharp!cast side.low }
    torso { up:3 back.80 fwd.80@sharp up }
    head  { fwd:3 fwd.20 fwd:2@sharp }
  }
}

form Float { Float }
form Cast { Cast }

score Float { dancer mage  form Float  loop }
score Cast { dancer mage  form Cast }
