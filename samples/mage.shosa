// Mage — `free` on the dancer: the rules of weight and gravity do not apply to this body,
// so it can hang in the air.
title "Mage"
tempo 90


figure mage
dancer mage humanoid on mage free

pose hover {
  steps    { lift(0.3) }                    // the feet 0.3 m above the floor
  leftLeg  { fwd.-70@bent }
  arms     { side.low }
}

section Float {
  mage {
    body  { hover:4 }
    arms  { side.-30:2 side.low:2 }
  }
}

section Cast {
  mage {
    body  { hover:0 }
    arms  { side.high:2 up:1 fwd:0.15s@sharp!cast hold:1 side.low:2 }
    torso { back.80:3 fwd.80:0.15s@sharp up:2 }
    head  { fwd.20:3 fwd:0.15s@sharp }
  }
}

form Float { Float }
form Cast { Cast }

score Float { dancer mage  form Float  loop }
score Cast { dancer mage  form Cast }
