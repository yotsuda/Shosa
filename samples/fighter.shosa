// Fighter — the movements of one game character. Each is a score of its own, and a score
// is one file written: fighter-Idle.glb, fighter-Combo.glb …
// `!name` marks a moment for the engine (a hit, a footstep).
title "Fighter"
tempo 120                                   // one beat = 0.5 s

// The guard, the punches, the kick and the step in are in a file of parts, for every file of
// this character (samples\parts\fighter.shosa). They are used here as if written here.
using "parts/fighter.shosa"

figure fighter
dancer fighter humanoid on fighter

section Idle {
  fighter {
    body { guard:8 }                          // a loop follows itself: already in guard
    head { fwd.left:2 fwd:2 fwd.right:2 fwd:2 }
  }
}

section Advance {
  fighter {
    body  { guard:1 }
    steps { stepIn:1 }
  }
}

section Walk {
  fighter {
    steps    { left.fwd!step right.fwd!step }
    leftArm  { back.-70 fwd.-70 }             // arm swing, 20 degrees from hanging
    rightArm { fwd.-70 back.-70 }
  }
}

section Jab {
  fighter {
    body { guard:0.2s jab:0.4s }              // in guard; the fist is out at 0.2 s (!hit) and back at 0.4 s
  }
}

section Combo {
  fighter {
    // `&`: the two sides happen together. Punches while stepping in; the weight ends on
    // the right foot, so the kick is the mirrored one (the left leg).
    // A word is written at the beat the body is there: the jabs land on 2 and the half after it,
    // the cross on 3, the kick's knee is up on the next 1 and the kick lands half a beat later.
    // The cross is a row of its own beside the jabs (`skip`: the row leaves that time to the
    // others): the right fist is drawn back while the second jab lands, and is out half a beat on.
    body { guard:1 { jab:1/2 jab:1/2 skip } & { skip:1/2 cross:3/2 } & { stepIn:2 } then | frontKick@mirror:2 guard:2 | }
  }
}

section Hurt {
  fighter {
    body  { guard:0.6s }
    steps { skip:0.2s right.back.low:0.4s!stagger }   // from guard the right foot goes 0.2 m further back
    torso { up:0.2s back.70:0.2s@sharp up:0.2s }      // thrown back at 0.2 s, upright again at 0.4 s
    head  { fwd:0.2s fwd.-30:0.2s@sharp fwd:0.2s }
  }
}

section Victory {
  fighter {
    body  { guard:4 }
    steps { skip together jump jump }         // the feet close on 2; the jumps land on 3 and 4
    arms  { skip down:1/2 side.high:1/2 up:2 }
  }
}

form Idle { Idle }
form Advance { Advance }
form Walk { Walk }
form Jab { Jab }
form Combo { Combo }
form Hurt { Hurt }
form Victory { Victory }

score Idle { dancer fighter  form Idle  loop }
score Advance { dancer fighter  form Advance  loop inplace }
score Walk { dancer fighter  form Walk  loop inplace }
score Jab { dancer fighter  form Jab }
score Combo { dancer fighter  form Combo }
score Hurt { dancer fighter  form Hurt }
score Victory { dancer fighter  form Victory }
