// Square — three steps, the third one turning a quarter: four times round a square.
// `@turn(...)` turns during the step; `turn.left.quarter` alone is still a pivot on the spot.
title "Square"
tempo 110
time 3/4

role solo
dancer solo humanoid on solo

section Side {
  solo {
    steps { leftFoot.fwd rightFoot.fwd leftFoot.fwd@turn(left(90)) }
  }
}

form { |: Side :|*4 }

score { dancer solo }
