// Juggling, in siteswap as jugglers write it: each digit is a throw, and how long
// until that ball is thrown again. A trick goes on a pattern with `@`.
// A pattern with a length goes on for that long; one without is thrown once through.
// Four jugglers: five balls in the middle, three balls and five clubs beside her,
// and seven rings a little way behind.
// The characters are not in the repository: models/README.md says where they come from.
title "Juggle"
tempo 116

role three
role five
role clubs
role rings
dancer zunko humanoid "../out/vrm/zunko.vrm" juggles balls on five
dancer zundamon humanoid "../out/vrm/zundamon.vrm" juggles balls on three at -1.7 0
dancer clubber humanoid "../out/vrm/sample.vrm" juggles clubs on clubs at 1.7 0
dancer ringer humanoid "../out/vrm/sample.vrm"  juggles rings on rings at 0.5 -2.2

section Show {
  three {
    juggle { every 1/2
             3:4 | 3:4@reverse |                 // a cascade, then thrown over the top
             531:3 3:1 | 441:3 3 4 |             // a tower; a box of 4s; a 4 into the shower
             51:4 | 2 52512 3 3 |                // a shower; a 2 out of it into 52512
             55500 3 3 4 | 7131 7131 |           // a flash of three 5s; one ball very high
             2 3 4413 3 3 | 5241 5241 |
             45141 3 3 3 | 3:4@tennis |          // one ball to and fro over the others
             3:3@halfShower 3:1 | 3:4@mills |    // Mills' Mess: the arms cross and uncross
             3:4@mills | 3:4@windmill |          // a windmill: all one way round
             3:4@windmill | 423:4@takeouts |     // takeouts: a hand swipes its own 4 away
             423:4@takeouts | 423:4@takeouts |
             3:2 3:1@clawCatch 3:1 | skip:2 (4,2x)*:2 |   // snatched from above; both hands at once
             (4,2x)*:4 | skip:1 3:3 |
             3:2 skip:2 | }
    steps  { then:4 | leftFoot.side together rightFoot.side together | }
    torso  { skip:24bar | up:2 up.fwd(30):1 up:1 | }
  }

  // Five balls, three throws a beat: twelve to the bar.
  five {
    juggle { every 1/3
             5:4 | 5:4 |
             645:4 | 744:4 |
             5:4 | 75751:10/3 5:2/3 |
             753:2 5:2 | 663:4 |
             5:4 | 97531:10/3 5:2/3 |            // a tower of five
             7733:4 | 66661:10/3 5:2/3 |
             5:4 | 645:4 |
             744:4 | 75751:10/3 5:2/3 |
             5:4 | 753:4 |
             97531:10/3 5:2/3 | 663:4 |
             7733:4 | 66661:10/3 5:2/3 |
             97531:10/3 5:2/3 | 5:4 |
             5:2 skip:2 | }
    torso  { skip:24bar | up:2 up.fwd(30):1 up:1 | }
  }

  // Five clubs need height to turn: nothing lower than a 4 at a throw every half beat.
  clubs {
    juggle { every 1/2
             5:4 | 5:4 |
             645:3 5:1 | 744:3 5:1 |
             5:4 | 7445:4 |
             6455:4 | 5:4 |
             64645:5/2 5:3/2 | 645:3 5:1 |
             744:3 5:1 | 5:4 |
             7445:4 | 645:3 5:1 |
             6455:4 | 5:4 |
             744:3 5:1 | 64645:5/2 5:3/2 |
             7445:4 | 5:4 |
             645:3 5:1 | 744:3 5:1 |
             6455:4 | 5:4 |
             5:2 skip:2 | }
    torso  { skip:24bar | up:2 up.fwd(30):1 up:1 | }
  }

  // Seven rings: nothing lower than a 6, or they meet in the air.
  rings {
    juggle { every 1/3
             7:4 | 7:4 |
             867:4 | 7:4 |
             966:4 | 9667:4 |
             7:4 | 86867:10/3 7:2/3 |
             8677:4 | 7:4 |
             96686:10/3 7:2/3 | 867:4 |
             7:4 | 7:4@halfShower |              // one hand over the top, the other under
             7:4@halfShower | 7:4 |
             9667:4 | 966:4 |
             7:4 | 86867:10/3 7:2/3 |
             8677:4 | 7:4@reverse |              // thrown from outside over the top
             96686:10/3 7:2/3 | 7:4 |
             7:2 skip:2 | }
    torso  { skip:24bar | up:2 up.fwd(30):1 up:1 | }
  }
}

form { Show }
score { dancer zunko  dancer zundamon  dancer clubber  dancer ringer }
