// Box step — "forward, side, together; back, side, together". It ends where it began,
// so the score is a `loop`: the end joins the start and an engine can repeat it.
title "Box step"
tempo 90
time 3/4

figure solo
dancer solo humanoid on solo

section Box {
  solo {
    steps { left.fwd right.side together | right.back left.side together }
    arms  { side.low:6 }
  }
}

form { Box }
score { dancer solo  loop }
