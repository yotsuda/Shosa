// The face: a look, then the eyes. It is there on its beat and changes in a moment;
// the eyes blink by themselves. A face needs a character: models/README.md says where one comes from.
tempo 112
time 4/4

role idol
dancer idol humanoid "models/zunko.vrm" on idol

section Hello {
  idol {
    steps    { stand:4 | rightFoot.side(0.4m):2 together:2 | leftFoot.side(0.4m):2 together:2 | stand:4 | }
    // A wave, a point to the audience, a "eh?!", a heart.
    rightArm { side.up(40).bent(60):1 side.up(50).bent(30):1 side.up(40).bent(60):1 side.up(50).bent(30):1 |
               fwd.up(10):2@sharp then:2 | then:2 side.up(20).bent(40):2 | chest:4 | }
    leftArm  { hip:4 | then:4 | then:2 side.up(20).bent(40):2 | chest:4 | }
    hands    { spread.fingers(up).palm(fwd):4 | point:4 | spread:4 | heart:4 | }
    head     { fwd.tilt(right(10)):4 | fwd:4 | fwd.up(10):4 | fwd.tilt(left(12)):4 | }
    // A smile to dance in is about half of the whole one; the word is the whole face, so the look
    // is written again beside the wink.
    face     { smile(50):4 | smile(50):2 smile(60).winkRight:1 smile(50):1 | then:2 surprised:2 | smile:4 | }
  }
}

form { Hello }
score { dancer idol }
