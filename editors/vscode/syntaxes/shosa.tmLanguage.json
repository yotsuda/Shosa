{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Shosa",
  "scopeName": "source.shosa",
  "patterns": [
    { "include": "#comment" },
    { "include": "#string" },
    {
      "comment": "section NAME {",
      "match": "(?<![.@!:\\w])(section)\\b(?:[ \\t]+([A-Za-z_][A-Za-z0-9_]*))?",
      "captures": {
        "1": { "name": "keyword.control.shosa" },
        "2": { "name": "entity.name.section.shosa" }
      }
    },
    { "comment": "In a score: loop, inPlace.", "name": "storage.modifier.shosa", "match": "(?<![.@!:\\w])(loop|inPlace)\\b(?![.:@])" },
    {
      "comment": "dancer NAME humanoid on ROLE [at X Z] [facing …] [mirror] [delay N] [free] [in SECTION …] — one line. In a score: dancer NAME.",
      "begin": "(?<![.@!:\\w])(dancer)\\b(?:[ \\t]+([A-Za-z_][A-Za-z0-9_]*))?",
      "beginCaptures": {
        "1": { "name": "keyword.control.shosa" },
        "2": { "name": "entity.name.type.dancer.shosa" }
      },
      "end": "(?=[{}])|(?=\\b(?:form|tempo|title|music|score|dancer|loop|inPlace)\\b)|$",
      "name": "meta.dancer.shosa",
      "patterns": [
        { "include": "#comment" },
        { "include": "#string" },
        { "name": "support.type.shosa", "match": "\\bhumanoid\\b" },
        { "name": "keyword.other.clause.shosa", "match": "\\b(on|at|facing|mirror|delay|free|in)\\b" },
        { "name": "constant.language.facing.shosa", "match": "\\b(front|back|stageLeft|stageRight)\\b" },
        { "include": "#number" }
      ]
    },
    {
      "comment": "role NAME, pose NAME, move NAME, form [NAME], score [NAME], formation NAME; in a score: form NAME, score NAME.",
      "match": "(?<![.@!:\\w])(role|pose|move|form|score|formation)\\b(?:[ \\t]+([A-Za-z_][A-Za-z0-9_]*))?",
      "captures": {
        "1": { "name": "keyword.control.shosa" },
        "2": { "name": "entity.name.function.shosa" }
      }
    },
    { "name": "keyword.control.shosa", "match": "(?<![.@!:\\w])(using|title|tempo|time|fps|music|q|verse)\\b(?!\\.)" },
    { "name": "keyword.control.shosa", "match": "(?<![.@!:\\w])upbeat(?=[ \\t]+\\d)" },
    { "name": "entity.name.function.track.shosa", "match": "\\b(body|steps|height|arms|leftArm|rightArm|legs|leftLeg|rightLeg|turnout|hips|torso|shoulders|head|hands|leftHand|rightHand|juggle|quality)\\b(?=\\s*\\{)" },
    {
      "comment": "@turn(left.quarter): an annotation with arguments.",
      "begin": "(@[A-Za-z_][A-Za-z0-9_]*)(\\()",
      "beginCaptures": {
        "1": { "name": "entity.name.tag.annotation.shosa" },
        "2": { "name": "punctuation.section.arguments.begin.shosa" }
      },
      "end": "\\)|$",
      "endCaptures": { "0": { "name": "punctuation.section.arguments.end.shosa" } },
      "patterns": [
        { "include": "#number" },
        { "name": "variable.parameter.shosa", "match": "[A-Za-z_][A-Za-z0-9_]*" }
      ]
    },
    { "name": "entity.name.tag.annotation.shosa", "match": "@[A-Za-z_][A-Za-z0-9_]*" },
    { "name": "variable.other.constant.mark.shosa", "match": "![A-Za-z_][A-Za-z0-9_]*" },
    {
      "comment": "A length: beats (:2 :1/2 :1.5), seconds (:0.3s), frames (:12f).",
      "match": "(:)(\\d+(?:\\.\\d+)?(?:/\\d+)?)(?:(bar|[sf])\\b)?",
      "captures": {
        "1": { "name": "punctuation.separator.duration.shosa" },
        "2": { "name": "constant.numeric.duration.shosa" },
        "3": { "name": "keyword.other.unit.shosa" }
      }
    },
    {
      "comment": "Repeat signs of a form: |: :| :|: (and :|*4, whose *4 is coloured below). Not `|:2`, a bar line and the rest of a tie.",
      "name": "keyword.control.repeat.shosa",
      "match": ":\\|:(?!\\d)|\\|:(?!\\d)|:\\|"
    },
    {
      "comment": "A numbered ending of a form: [1. B] [1-2. B C].",
      "match": "(\\[)(\\d+(?:-\\d+)?\\.)",
      "captures": {
        "1": { "name": "punctuation.section.brackets.begin.shosa" },
        "2": { "name": "constant.numeric.ending.shosa" }
      }
    },
    { "name": "punctuation.section.brackets.end.shosa", "match": "\\]" },
    { "comment": "tempo 50%: a number in per cent, not the sign of a bar again.", "name": "constant.numeric.percent.shosa", "match": "(?<![A-Za-z0-9_.])\\d+(?:\\.\\d+)?%" },
    { "comment": "tempo 4. = 60: a tempo by its note.", "name": "keyword.operator.equals.shosa", "match": "=" },
    { "comment": "% and %2: the bar(s) before, again.", "name": "keyword.control.repeat.shosa", "match": "%\\d*" },
    { "comment": "A tie over a bar line: kick:2~ | :1.", "name": "keyword.operator.tie.shosa", "match": "~" },
    { "include": "#number" },
    { "name": "keyword.operator.bar.shosa", "match": "\\|" },
    { "name": "keyword.operator.together.shosa", "match": "&" },
    { "name": "keyword.operator.times.shosa", "match": "\\*" },
    { "name": "comment.block.hold.shosa", "match": "(?<![.@!\\w])(then|stay|skip)\\b(?!\\.)" },
    { "comment": "A height: height { low(8cm) mid straight high sit(0.45m) }, b.hand.high.", "name": "support.constant.level.shosa", "match": "(?<![\\w])(low|mid|straight|high|sit)\\b(?![\\w.])" }
  ],
  "repository": {
    "comment": { "name": "comment.line.double-slash.shosa", "match": "//.*$" },
    "string": { "name": "string.quoted.double.shosa", "match": "\"[^\"\\n]*\"?" },
    "number": {
      "comment": "120, 0.4, -1.5, and the degrees after a dot: fwd.-70, back.70.",
      "name": "constant.numeric.shosa",
      "match": "(?<![A-Za-z0-9_])-?\\d+(?:\\.\\d+)?\\b"
    }
  }
}
