// Temps leves on the right foot, the left at the back of the ankle; close to fifth, left foot front.
title "Temps leve"
tempo 96
time 2/4

role solo
dancer solo humanoid on solo

section TempsLeve {
  solo {
    turnout { out(80) }
    height  { straight }
    arms    { fwd.across(30).down(70).bent(40).elbow(side) }
    // fifth, right front (already standing); weight onto the right; three hops; close fifth left front
    steps   { rightFoot.fwd(0.08m).across(0.13m):1/2 shift.right:3/2 | hop:1 hop:1 | hop:1 then:1 | leftFoot.fwd(0.08m).across(0.13m):1 shift.center:1 | then:2 | }
    // sur le cou-de-pied behind, from beat 1 through the hops; down at beat 5
    leftLeg { skip:1/2 then:1/2 otherAnkle.back:1 | then:2 | then:1 down:1 | skip:2 | skip:2 | }
  }
}

form { TempsLeve }
score { dancer solo }
