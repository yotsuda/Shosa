title "Old man"
tempo 80
time 4/4

figure oldman
dancer oldman humanoid on oldman

// The back rounded over, the face lifted to look ahead.
pose curled  { torso { fwd.65@round }  head { fwd.40 } }
pose upright { torso { up }            head { fwd } }

section Main {
  oldman {
    // curled: bar 1 and through the walk; straightens beats 10-12, holds 12-14, curls 14-16
    body  { curled:4 | then:4 | then:2 then:2 | upright:2 then:2 | curled:4 | }
    // six small steps, landing on beats 4 to 9
    steps { then:4 | left.fwd@small right.fwd@small left.fwd@small right.fwd@small | left.fwd@small right.fwd@small then:2 | }
  }
}

form { Main }
score { dancer oldman }
