// Two changements from fifth (left foot front), then a plain sauté.
title "Changement"
tempo 120
time 4/4

role solo
dancer solo humanoid on solo

pose ballet {
  turnout { out(80) }
  arms    { fwd.across(30).down(70).bent(40).elbow(side) }
}

section Jumps {
  solo {
    body   { ballet:4 | then:4 | then:4 | }
    // fifth, left foot front; the weight onto both feet; a changement landing on beats 2, 4; a sauté on 6
    steps  { leftFoot.fwd(0.08m).across(0.13m):1/2 shift.center:1/2 then:1 jump.change:1 then:1 | jump.change:1 then:1 jump:1 then:1 | then:4 | }
    // straight legs; the small plié before each jump is the jump's own bend (a written low(8cm) adds to it)
    height { straight:4 | then:4 | then:4 | }
  }
}

form { Jumps }
score { dancer solo }
