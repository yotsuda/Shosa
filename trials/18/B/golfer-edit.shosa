title "Golfer"
tempo 60           // one beat is one second

figure g
dancer g humanoid on g

section Swing {
  g {
    steps     { jump.apart:4 }                       // standing with the feet apart
    torso     { fwd.60:2.6 then:0.9 up:1 }           // bent 30 degrees from the hips, straight back; up at the finish
    hips      { center:1 then:1 right.20:0.4 left.20:1.1 left.45:1 }
    shoulders { center:1 then:1 right.45:0.4 right.10:1.1 left.90:1 }
    leftArm   { across.-70:1 then:1 across.high:0.5 across.-70:1 side.high@bent:1 }
    rightArm  { across.-70:1 then:1 side.high@bent:0.5 across.-70:1 across.high:1 }
    head      { fwd.-40:2.6 then:0.9 fwd.left(70):1 }  // on the ball, then after it
  }
}

form { Swing }
score { dancer g }
