title "Take cover"
tempo 90
time 4/4

role guard
dancer guard humanoid on guard

section Cover {
  guard {
    steps  { leftFoot.side(0.4m):1 then:2 shift.left:1 then:1 shift.center:2 }   // weight left 1-3, held to 4, centred 4-5
    height { mid low(40cm):4 then:1 mid:1 }                                      // crouch 0-1, held to 5, up 5-6
    torso  { up:1 then:2 up.right(30):1 then:1 up:2 }                            // lean right 1-3, held to 4, upright 4-5
  }
}

form Cover { Cover }
score Cover { dancer guard  form Cover }
