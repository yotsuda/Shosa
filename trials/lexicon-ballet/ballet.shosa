// Ballet: a first lexicon, written in the core words of Shosa alone (DESIGN.md 73).
// A trial, not a sample: what cannot be said, and what is only near, is written beside each word.
// The working leg is the right one; `@mirror` gives the left.

// Ballet stands on straight legs: the positions hold `height { straight }`, and every height move comes back to it (not `mid`, the soft knees of a row nobody wrote).
// ---- Positions of the feet. Without turnout: the feet and the knees point forward in all of them.
pose first   { steps { together }  height { straight } }                 // heels together (the toes should turn out)
pose second  { steps { rightFoot.side(0.41m) }  height { straight } }         // feet apart, 0.33 m (but the weight is on the right foot)
pose fourth  { steps { rightFoot.fwd(0.3m) }  height { straight } }          // the right foot a small step ahead
pose third   { steps { rightFoot.fwd(0.08m).across(0.04m) }  height { straight } }   // the right heel at the middle of the left foot (turned out)
pose fifth   { steps { rightFoot.fwd(0.08m).across(0.13m) }  height { straight } }   // the right heel at the left toes (turned out 80)

// ---- Positions of the arms: rounded with a little @bent, the elbows held out to the side (DESIGN.md 75).
pose brasBas     { arms { fwd.across(30).down(70).bent(40).elbow(side) } }   // low, in front of the thighs, rounded: the hands 19 cm apart
pose firstArms   { arms { fwd.across(15).down(25).bent(50).elbow(side) } }   // in front of the diaphragm: the hands 12 cm apart
pose secondArms  { arms { side.fwd(20).down(10).bent(15).elbow(back) } }   // out to the side, a little forward and below the shoulders, the palms forward
pose fifthArms   { arms { fwd.up(70).bent(40).elbow(side) } }    // en haut: above the head, a little forward
pose demiSeconde { arms { side.down } }
pose thirdArms   { leftArm { fwd.up(70).bent(40).elbow(side) }  rightArm { side.fwd(20).down(10).bent(15).elbow(back) } }

// ---- At the barre, and in the centre.
move demiPlie    { height { low(8cm) straight } }
move grandPlie   { height { low(40cm):2 straight:2 } }
move releve      { height { high straight } }
move tenduFwd    { rightLeg { fwd.down(65) down } }      // the foot along the floor to the front, pointed
move tenduSide   { rightLeg { side.down(65) down } }
move tenduBack   { rightLeg { back.down(65) down } }
move degageSide  { rightLeg { side.down@sharp down } }
move rondDeJambe { rightLeg { fwd.down(65) side.down(65) back.down(65) down } }   // a half circle on the floor, front to back
move retire      { rightLeg { otherKnee down } }                        // the toe at the knee of the other leg
move developpe   { rightLeg { otherKnee fwd.up(15):2 down } }               // up through retiré, unfold to the front
move grandBattement { rightLeg { fwd.up down } }   // thrown up fast and lowered with control: @sharp would be 15 m/s, too fast
move fondu       { height { low(8cm) straight }  rightLeg { otherAnkle fwd.down(30) } }   // from sur le cou-de-pied
move portDeBras  { arms { brasBas firstArms fifthArms secondArms brasBas } }

pose arabesque {
  rightLeg { back.up(10) }
  torso    { up.fwd(10) }                                // leaning 10 degrees forward
  leftArm  { fwd.up(15) }                                // the arm of the standing leg in front (first arabesque)
  rightArm { side.back(30).down(5) }
  head     { fwd }
}
pose attitude { rightLeg { back.up(20).bent.knee(side.up) }  arms { fifthArms } }   // the knee out and above the foot

// ---- Steps and jumps.
move saute       { steps { then:1/2 jump:1/2 } }          // the jump makes its own plié (one written in a height row before it is part of it)
move changement  { steps { then:1/2 jump.change:1/2 } }   // from fifth, lands in fifth with the other foot in front
move echappe     { steps { jump.apart jump.stand } }
move glissade    { steps { rightFoot.side(0.41m) together }  height { low(8cm) low } }
move pasDeBourree { steps { rightFoot.back.across leftFoot.side(0.41m) rightFoot.fwd }  height { high high low } }
move balance     { steps { rightFoot.side leftFoot.back.across rightFoot.place }  height { straight high straight } }
move chasse      { steps { rightFoot.fwd together rightFoot.fwd }  height { low high low } }
move pique       { steps { rightFoot.side }  height { high }  leftLeg { otherKnee } }
move pirouette   { steps { shift.left turn.right(360) shift.center }  rightLeg { otherKnee:2 down } }
move chaines     { steps { rightFoot.side@turn(right(180)) leftFoot.place@turn(right(180)) }  height { high high } }

move reverence {
  steps { rightFoot.side(0.41m) leftFoot.back.across:2 together }
  height { straight low:2 straight }
  torso { up up.fwd(20):2 up }
  head  { fwd fwd.down(40):2 fwd }
  arms  { brasBas secondArms:2 brasBas }
}
