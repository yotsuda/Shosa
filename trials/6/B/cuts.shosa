// One dancer, one file, three files written: the whole song, a chorus practice, a verse loop.
// The choreography is that of solo.shosa.
title "Cuts"
music "song.lys"

figure solo
dancer solo humanoid on solo

// Verse: the feet are the same both times; the arms differ in bars 3-4 the second time.
section Verse {
  solo {
    steps { left.side together right.side together | % | % | % | }
    arms  { side:2 down:2 | fwd:2 down:2 |
            verse 1 { %2 | }
            verse 2 { fwd:2 up:2 | side:2 down:2 | } }
  }
}

// Chorus: the second time a score plays it, the last bar ends with a jump.
section Chorus {
  solo {
    steps { left.fwd together right.back together | % | % |
            verse 1 { % | }
            verse 2 { left.fwd:1/2 together:1/2 right.back:1/2 together:1/2 hold:1 jump:1 | } }
    arms  { side:1 up:1 side:1 clap:1 | % | % | side:1 up:1 hold:2 | }
  }
}

// Outro: the arms come down slowly, through the side.
section Outro {
  solo {
    arms { side:4 | down:4 | }
  }
}

form chorusTwice { |: Chorus :| }
form verseOnly   { Verse }

score                { dancer solo }                                  // the whole song, in the song's order
score chorusPractice { dancer solo  form chorusTwice  tempo 80 }      // Chorus Chorus; the second ends with the jump
score verseLoop      { dancer solo  form verseOnly  loop }            // Verse, going round
