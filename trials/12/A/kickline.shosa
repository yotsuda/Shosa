title "Kick line"
tempo 126
time 4/4

figure solo
dancer solo humanoid on solo

// Bars 1-3: left steps on 1, right kick on 2, right steps on 3, left kick on 4. Hands on hips.
// Bar 4: jump lands on 1, clap on 2, clap on 3, arms out and up on 4.
section Line {
  solo {
    steps    { left.fwd@small:2!step right.fwd@small:2!step | % | left.fwd@small:2!step right.fwd@small:1.5!step hold:1/2 | jump.together:1!land hold:3 | }
    rightLeg { hold:1 fwd:1/2!kick down:1/2 skip:2 | % | % | }
    leftLeg  { skip:2 hold:1 fwd:1/2!kick down:1/2 | % | % | }
    arms     { hip:4 | hold:4 | hold:4 | hold:1 clap:1/2@sharp!clap fwd:1/2@bent clap:1/2@sharp!clap hold:1/2 side.high:1!pose | }
  }
}

form { Line }
score { dancer solo }
