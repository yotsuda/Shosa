// Song — a tune with two verses and two choruses. Written in Lily#.
title "Song"
tempo 108
time 4/4
key c major

part melody "Melody" { clef treble }

section Intro {
  chords harmony { C | G | }
  melody {
    c'2 e | g2 g |
  }
}

section Verse {
  chords harmony { C | Am | F | G | }
  melody {
    e'4 g g a | g4 e c2 | f4 a a g | f4 e d2 |
  }
}

section Chorus {
  chords harmony { F | C | G | C | }
  melody {
    a'4 a c a | g4 g e2 | d4 g b d | c2. r4 |
  }
}

section Outro {
  chords harmony { F | C | }
  melody {
    a'2 f | c1 |
  }
}

form { Intro Verse Chorus Verse Chorus Outro }

score {
  chords harmony
  staff melody
}