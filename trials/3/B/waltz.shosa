title "Waltz box"
tempo 150
time 3/4

section Waltz {
  // The box: forward-side-together, back-side-together.
  steps    { left.fwd right.side together | right.back left.side together | %2 | %2 | %2 | }
  // Low at the side; from beat 2 of bar 1 up over 4 beats, down the other way over 4, back.
  rightArm { side.low:0 hold:1 up:2~ | :2 across.low:1~ | :3 | side.low:3 | %4 | }
}
