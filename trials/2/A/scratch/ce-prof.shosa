title "Combo"
tempo 120
dancer me humanoid facing stageLeft
time 2/4

pose stance {
  steps { left.fwd.low@small }
  arms  { fwd.high@bent }
}

// 1: fast left palm strike
move palm { leftArm { fwd:1/2@sharp!hit1 stance:1/2 } }

// 2: right punch to the body
move bodypunch { rightArm { fwd.low:1/2@sharp!hit2 stance:1/2 } }

// 3: spinning back kick: turn the back to the opponent on the left foot, kick straight back
move spinkick {
  steps    { turn.right.half:1 hold:1 }
  rightLeg { back.low:1@bent back:1@sharp!hit3 }
}

// the leg comes down, the turn goes on round to the front
move recover {
  steps    { hold:1 turn.right.half:1 }
  rightLeg { down:1 }
}

section Combo {
  body { stance:0 | palm:1 hold:1 | spinkick:2@mirror | recover:2@mirror | }
  rightArm { skip:3/2 bodypunch:1 }
  steps { skip:1 shift.right:1 }
}
