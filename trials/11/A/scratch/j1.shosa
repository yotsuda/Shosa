title "Jig set"
time 6/8
tempo 4. = 100

figure solo
dancer solo humanoid on solo

section Jig {
  tempo 4. = 100
  solo {
    steps { left.side:2 together:1 right.side:2 together:1 | % | }
    arms  { hip:6 | hold:6 | }
  }
}

section Slip {
  time 9/8
  solo {
    steps { left.fwd:3 right.fwd:3 together:3 | left.back:3 right.back:3 together:3 | }
    arms  { side:3 hold:3 hip:3 | % | }
  }
}

section Reel {
  time 2/4
  solo {
    steps { left.side together | right.side together | %2 | }
    arms  { clap:1 hip:1 | % | %2 | }
  }
}

form { Jig Slip Jig Reel Jig }
score { dancer solo }
