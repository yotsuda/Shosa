title "Crouch"
tempo 60           // one beat is 1 s
time 4/4

role hero
dancer hero humanoid on hero

// Breathing: the hips 2 cm down and back up, a 3-second cycle.
section Idle {
  hero {
    arms   { down:3 }
    height { mid:1.5 low(2cm):1.5 }
  }
}

// Sink evenly 0.8 s to 25 cm lower, stay 1 s, spring up in 0.2 s.
section Crouch {
  hero {
    arms   { down:2.5s }
    height { mid:0.8s low(25cm):1s@linear then:0.2s!spring mid:0.5s }
  }
}

form Idle   { Idle }
form Crouch { Crouch }

score Idle   { dancer hero  form Idle  loop  inPlace }
score Crouch { dancer hero  form Crouch  inPlace }
