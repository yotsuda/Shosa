title "Class"
tempo 90
time 3/4

role solo
dancer solo humanoid on solo

pose first {
  turnout { out(80) }
  steps   { together }
  arms    { fwd.down(70).bent(30).elbow(side) }
}
pose fifth { arms { fwd.up(70).bent(40).elbow(side) } }

section Class {
  solo {
    steps   { first:3 | }
    turnout { first:3 | }
    // two demi-pliés of 20 cm (bars 1-4), relevé rising over 3 beats (bar 5)
    height  { mid:3 | low(20cm):3@linear | mid:3@linear | low(20cm):3@linear | mid:3@linear | high:3 | then:2 mid:1 | }
    // passé on the LEFT leg at 24, down at 28; right attitude at 30, held 3 bars, closed in first at 42
    leftLeg  { skip:7bar | then:3 | otherKnee:3 | then:1 down:2 | }
    rightLeg { skip:9bar | skip:1 then:2 | back.bent.knee(side.up):3 | then:2bar | then:3 | down:3 | }
    arms     { first:3 | then:6bar | then:3 | fifth:3 | then:4bar | then:3 | first:3 | }
    leftArm  { skip:9bar | then:3 | side:3 | then:2bar | then:3 | first:3 | }
  }
}

form { Class }
score { dancer solo }
