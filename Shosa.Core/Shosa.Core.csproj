<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Shosa.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- The synthesiser of the VS Code preview; `shosa preview` writes it into its page (PreviewHtml). -->
    <EmbeddedResource Include="..\editors\vscode\src\preview\sound.js" LogicalName="sound.js" />
    <EmbeddedResource Include="..\editors\vscode\src\preview\time.js" LogicalName="time.js" />
  </ItemGroup>

</Project>
